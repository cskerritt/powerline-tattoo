PORT=3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact + booking form submissions are emailed.
# Defaults to info@powerlinetattoo.com if unset.
MAIL_TO=info@powerlinetattoo.com

# Google reviews (homepage testimonials). Enable the Places API (New) in
# Google Cloud and create an API key. GOOGLE_PLACE_ID is the Place ID for
# the Powerline Tattoo Google Business listing.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACE_ID=your-google-place-id
